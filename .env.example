# Copy to .env for local development (netlify dev loads it automatically).
# In Netlify: Site configuration -> Environment variables.
VWO_ACCOUNT_ID=
VWO_SDK_KEY_PROD=
VWO_SDK_KEY_STAGING=
VWO_SDK_KEY_DEV=
# Long random string used to sign login sessions: openssl rand -hex 32
JWT_SECRET=
# Optional: shared secret Wingify sends in the x-vwo-auth header of webhooks
VWO_WEBHOOK_KEY=
# Optional: force the default FE environment (dev | staging | prod)
FE_DEFAULT_ENV=
